*.py[cod]
.pytest_cache/
.mypy_cache/

# Local environment files
.env
.env.*
!.env.template
!.env.example
!config/.env.template

# Logs and runtime failure records
logs/**
*.jsonl

# Local databases and generated state
*.db
*.sqlite
*.sqlite3

# Generated reports and review outputs
data/reports/
reviews/daily/
reviews/weekly/

