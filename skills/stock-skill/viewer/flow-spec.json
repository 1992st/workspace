  "flows": [
    {
      "id": "runtime-call",
      "title": "运行时 Action 调用",
      "description": "通过 run.py CLI 入口调用任意 action：quote.get / kline.get / flow.main.get / analysis.stock.prepare 等。自动处理降级、缓存、异常记录。",
      "intent": "统一的数据查询入口，调用者只需指定 skill/action/input。",
      "trigger": "手动调用 run.py 或由 Agent 编排触发。",
      "inputs": [
        "技能名（stock）",
        "action 名",
        "JSON input 参数"
      ],
      "outputs": [
        "{status, data, meta, quality, error}"
      ],
      "decision_points": [
        "主源（akshare）失败 → HTTP 备源兜底",
        "双源均失败 → 返回缓存数据（标注 cache=true）",
        "同时记录失败到 tool_failures/ 日志"
      ],
      "blockers": [
        "非交易日部分非缓存在接口可能返回空"
      ],
      "tuning_points": [
        {
          "title": "TTL 调整",
          "description": "各 action 缓存 TTL 可独立调优",
          "files": [
            "skill_runtime/stock_skill.py"
          ]
        },
        {
          "title": "降级策略",
          "description": "主/备源优先级和切换条件",
          "files": [
            "skill_runtime/providers/__init__.py"
          ]
        }
      ],
      "steps": [
        {
          "id": "parse-input",
          "title": "解析输入",
          "description": "解析 action 名称和 JSON input 参数。",
          "kind": "read",
          "evidence": [
            "scripts/run.py"
          ],
          "files": [
            "scripts/run.py"
          ]
        },
        {
          "id": "check-cache",
          "title": "检查缓存",
          "description": "根据 TTL 从 FileCache 检查是否存在有效缓存。",
          "kind": "run",
          "evidence": [
            "skill_runtime/shared/cache.py"
          ],
          "files": [
            "skill_runtime/shared/cache.py"
          ]
        },
        {
          "id": "call-primary",
          "title": "调用主数据源",
          "description": "优先使用 akshare 获取数据。",
          "kind": "run",
          "evidence": [
            "skill_runtime/providers/akshare_provider.py"
          ],
          "files": [
            "skill_runtime/providers/akshare_provider.py"
          ]
        },
        {
          "id": "fallback-on-fail",
          "title": "主源失败 → 降级",
          "description": "主源异常时自动切 HTTP 备源。双源全失败则返回缓存。",
          "kind": "decide",
          "evidence": [
            "skill_runtime/stock_skill.py",
            "skill_runtime/providers/http_provider.py"
          ],
          "files": [
            "skill_runtime/stock_skill.py",
            "skill_runtime/providers/http_provider.py"
          ]
        },
        {
          "id": "record-failure",
          "title": "记录工具异常",
