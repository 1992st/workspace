{
  "_classification_note__design_first": "stock-skill 是 Win_Stock 的统一 A 股数据接口层，不是 prompt 驱动的对话 skill，而是以 Python 运行时为核心的脚本驱动 skill。它提供 21 个结构化 action + 分析资源注入 + 分析结果校验。能力按数据领域分层：行情、资金、新闻、基本面、深度分析。每个 action 有统一输出契约（status/data/meta/quality/error）。降级和缓存由运行时透明处理。",
  "summary": {
    "responsibility": "为 Agent 提供统一、可缓存、可降级、可追溯的 A 股数据接口。统一契约封装上游数据源，先服务分析链路，不暴露上游细节。",
    "when_to_use": [
      "需要获取 A 股个股实时行情或批量行情",
      "需要获取个股 K 线/指数/交易日历",
      "需要分析主力资金流向或大单成交统计",
      "需要查看个股或市场新闻",
      "需要查询融资融券余额、沪股通活跃股、龙虎榜、大宗交易",
      "需要查看板块地图与热度",
      "需要个股基本面估值和关键指标",
      "需要分析准备（数据收集 + 策略注入 + 知识注入）",
      "需要校验分析结果是否真实引用注入策略"
    ],
    "when_not_to_use": [
      "不需要 A 股数据或港股/美股等其他市场的行情",
      "需要实时逐笔交易明细（当前未提供）",
      "需要财务三表手工录入或修改（当前只读查询）"
    ],
    "core_outputs": [
      "quote.get — 个股实时行情（主/备源自动降级）",
      "kline.get — 日K/周K/月K/分钟K",
      "analysis.stock.prepare — 数据整合 + 策略注入 + 知识注入",
      "analysis.result.validate — 分析结果策略引用校验"
    ],
    "boundaries": [
      "不保证盘前盘后数据返回频率一致",
      "高阶接口（margin.balance/hsgt.top10/lhb/block_trade）按盘后口径使用",
      "etf.pcf 是申购赎回清单，非实时净申赎结果",
      "不包含浏览器降级编排（由 skills/stock-data/ 处理）",
      "缓存命中会标注 cache=true，不伪装实时数据"
    ]
  },
